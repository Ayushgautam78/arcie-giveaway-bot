# REQUIRED
DISCORD_TOKEN=your_discord_bot_token_here
GROQ_API_KEY=your_groq_api_key_here

# OPTIONAL (fallback AI key)
GROQ_FALLBACK_API_KEY=your_second_groq_key_here

# OPTIONAL (image generation)
NVIDIA_IMAGE_API_KEY=your_nvidia_cloud_key_here

# SERVER & ALLOCATION CONFIG
PORT=2025
HOST=0.0.0.0
APP_URL=http://n5.nexcloud.in:2025

# OPTIONAL (Discord OAuth2 for Giveaway Dashboard)
DISCORD_CLIENT_ID=1234567890
DISCORD_CLIENT_SECRET=your_discord_oauth_secret
DISCORD_REDIRECT_URI=http://n5.nexcloud.in:2025/api/auth/callback

# OPTIONAL (persistent memory path for Railway)
# DATA_DIR=/data

